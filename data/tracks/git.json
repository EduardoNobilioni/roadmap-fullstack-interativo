            },
            {
              "title": "Sobre o Git (GitHub Docs)",
              "url": "https://docs.github.com/pt/get-started/using-git/about-git",
              "lang": "pt",
              "kind": "documentacao"
            }
          ]
        },
        {
          "id": "gt-branch",
          "level": "iniciante",
          "hours": 4,
          "title": "Branch",
          "description": "Branch é uma linha de trabalho. A principal fica estável. Branch curta, com um objetivo, cabe na revisão.",
          "tags": [
            "Branch"
          ],
          "prerequisites": [
            "gt-commit"
          ],
          "resources": [
            {
              "title": "Livro do Git em português",
