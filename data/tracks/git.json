              "lang": "pt",
              "kind": "leitura"
            }
          ]
        },
        {
          "id": "gt-conflito",
          "level": "intermediario",
          "hours": 3,
          "title": "Conflito",
          "description": "Conflito é as duas linhas editarem o mesmo trecho. Você escolhe o resultado e commita a resolução. Apagar o arquivo para \"resolver\" perde os dois lados.",
          "tags": [
            "Conflito"
          ],
          "prerequisites": [
            "gt-branch"
          ],
          "resources": [
            {
              "title": "Livro do Git em português",
              "url": "https://git-scm.com/book/pt-br/v2",
              "lang": "pt",
              "kind": "leitura"
            },
            {
              "title": "Hello World no GitHub",
              "url": "https://docs.github.com/pt/get-started/start-your-journey/hello-world",
              "lang": "pt",
              "kind": "pratica"
            }
          ]
        }
      ],
      "projects": [
        {
          "id": "gt1-projeto-iniciante",
          "level": "iniciante",
          "hours": 3,
          "title": "Três commits",
          "description": "Num repositório novo, faça três commits pequenos com mensagens que dizem a mudança.",
          "steps": [
            "Não commite pasta de dependência.",
            "Leia o log.",
            "Uma mensagem explica o porquê."
          ],
          "definitionOfDone": [
            "O log tem três entradas legíveis.",
            "Não há arquivo gerado."
          ]
        },
        {
          "id": "gt1-projeto-intermediario",
          "level": "intermediario",
          "hours": 4,
          "title": "Uma branch",
          "description": "Faça a mudança numa branch e junte na principal quando o exemplo funcionar.",
          "steps": [
            "A principal não recebe o experimento quebrado.",
            "A branch tem um nome do objetivo.",
            "O merge está no log."
          ],
          "definitionOfDone": [
            "Dá para ver a branch no histórico.",
            "O objetivo cabe no nome."
          ]
        },
        {
          "id": "gt1-projeto-avancado",
          "level": "avancado",
          "hours": 5,
          "title": "Resolver de propósito",
          "description": "Provoque um conflito em duas branches e resolva deixando os dois pedaços que importam.",
          "steps": [
            "Edite a mesma região.",
            "Abra os marcadores.",
            "Escreva o que você manteve."
          ],
          "definitionOfDone": [
            "O arquivo final não tem marcador.",
            "Os dois intents estão representados ou você explica o descarte."
          ]
        }
      ],
      "quiz": [
        {
          "id": "gt-fase-1-q1",
          "prompt": "A mensagem de commit deve ajudar quem lê a saber...",
          "reviewTopicId": "gt-commit",
          "choices": [
            {
              "id": "a",
              "text": "Por que a mudança existe.",
              "correct": true,
              "explanation": "O diff já mostra o quê."
            },
            {
              "id": "b",
              "text": "A hora exata do seu fuso.",
              "correct": false,
              "explanation": "A data já fica no commit."
            },
            {
              "id": "c",
              "text": "O nome de todas as variáveis.",
              "correct": false,
              "explanation": "Isso é o diff."
            }
          ]
        },
        {
          "id": "gt-fase-1-q2",
          "prompt": "Marcador de conflito deixado no arquivo significa...",
          "reviewTopicId": "gt-conflito",
          "choices": [
            {
              "id": "a",
              "text": "Que a resolução ainda não terminou.",
              "correct": true,
              "explanation": "O arquivo não compila como código seu."
            },
            {
              "id": "b",
              "text": "Que o Git escolheu o lado certo.",
              "correct": false,
              "explanation": "Git não escolhe o sentido."
            },
            {
              "id": "c",
              "text": "Que a branch foi apagada.",
              "correct": false,
              "explanation": "Branch e marcador são coisas diferentes."
            }
          ]
        }
      ]
    },
    {
      "id": "gt-fase-2",
      "number": 2,
      "badgeTitle": "Remoto",
      "title": "GitHub e pull request",
      "topics": [
        {
          "id": "gt-remoto",
          "level": "iniciante",
          "hours": 3,
          "title": "Remoto",
          "description": "O remoto é outra cópia. push envia, pull traz. O histórico que você não puxou explica o \"rejeitado\".",
          "tags": [
            "GitHub"
          ],
          "prerequisites": [
            "gt-commit"
          ],
          "resources": [
            {
              "title": "Hello World no GitHub",
              "url": "https://docs.github.com/pt/get-started/start-your-journey/hello-world",
