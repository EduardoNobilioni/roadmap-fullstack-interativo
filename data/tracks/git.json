          "id": "gt-commit",
          "level": "iniciante",
          "hours": 4,
          "title": "Commit",
          "description": "Commit é um instantâneo com mensagem. A mensagem diz por quê. Stage escolhe o que entra. Não junte correção e formatação se você pode separar.",
          "tags": [
            "Git"
          ],
          "prerequisites": [],
          "resources": [
            {
              "title": "Livro do Git em português",
              "url": "https://git-scm.com/book/pt-br/v2",
