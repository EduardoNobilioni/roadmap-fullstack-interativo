              "kind": "pratica"
            }
          ]
        },
        {
          "id": "gt-pr",
          "level": "intermediario",
          "hours": 4,
          "title": "Pull request",
          "description": "O PR descreve o que mudou, como ver e o que ficou de fora. Revisão é conversa sobre o diff, não sobre a pessoa.",
          "tags": [
            "Pull request"
          ],
          "prerequisites": [
            "gt-branch",
            "gt-remoto"
          ],
          "resources": [
            {
              "title": "Sobre pull requests",
              "url": "https://docs.github.com/pt/pull-requests/collaborating-with-pull-requests/proposing-changes-to-your-work-with-pull-requests/about-pull-requests",
              "lang": "pt",
              "kind": "documentacao"
            }
          ]
        },
        {
          "id": "gt-segredo",
          "level": "intermediario",
          "hours": 2,
          "title": "O que não entra no git",
          "description": "Senha, token e arquivo de ambiente local ficam de fora. Se entrou, trocar a senha importa mais do que apagar o arquivo no commit seguinte: o histórico guarda.",
          "tags": [
            "Segredo"
          ],
          "prerequisites": [
            "gt-commit"
          ],
          "resources": [
            {
              "title": "Sobre o Git (GitHub Docs)",
              "url": "https://docs.github.com/pt/get-started/using-git/about-git",
              "lang": "pt",
              "kind": "documentacao"
            }
          ]
        }
      ],
      "projects": [
        {
          "id": "gt2-projeto-iniciante",
          "level": "iniciante",
          "hours": 3,
          "title": "Repositório no GitHub",
          "description": "Publique um exercício com README de cinco linhas: o que é e como rodar.",
          "steps": [
            "Crie o remoto.",
            "Não suba dependência.",
            "O README abre sozinho."
          ],
          "definitionOfDone": [
            "O link abre.",
            "Não há segredo."
          ]
        },
        {
          "id": "gt2-projeto-intermediario",
          "level": "intermediario",
          "hours": 5,
          "title": "Um PR para você mesmo",
          "description": "Abra um pull request com descrição, mesmo que você seja quem aprova. A descrição diz como testar.",
          "steps": [
            "Branch separada.",
            "Texto de teste.",
            "Um item que ficou de fora."
          ],
          "definitionOfDone": [
            "O PR tem descrição.",
            "O diff é pequeno o bastante para ler."
          ]
        },
        {
          "id": "gt2-projeto-avancado",
          "level": "avancado",
          "hours": 4,
          "title": "Vazou a chave",
          "description": "Simule com uma chave falsa: commite, ache no histórico e escreva o que faria com uma chave verdadeira (revogar), além de tirar do arquivo.",
          "steps": [
            "Use um valor claramente falso.",
            "Mostre que o commit antigo ainda tem.",
            "Escreva o passo de revogar."
          ],
          "definitionOfDone": [
            "O valor falso está identificado.",
            "A conclusão não é só \"apaguei o arquivo\"."
          ]
        }
      ],
      "quiz": [
        {
          "id": "gt-fase-2-q1",
          "prompt": "Apagar o arquivo no commit seguinte remove o segredo?",
          "reviewTopicId": "gt-segredo",
          "choices": [
            {
              "id": "a",
              "text": "Não. O commit antigo continua com ele. Chave verdadeira se revoga.",
              "correct": true,
              "explanation": "Histórico é cópia."
            },
            {
              "id": "b",
              "text": "Sim, o Git esquece sozinho.",
              "correct": false,
              "explanation": "Não esquece."
            },
            {
              "id": "c",
              "text": "Sim, se a mensagem pedir desculpas.",
              "correct": false,
              "explanation": "Mensagem não reescreve o passado."
            }
          ]
        },
        {
          "id": "gt-fase-2-q2",
          "prompt": "A descrição do pull request existe para...",
          "reviewTopicId": "gt-pr",
          "choices": [
            {
              "id": "a",
              "text": "Quem revisa saber o que olhar e como testar.",
              "correct": true,
              "explanation": "O diff não traz o contexto todo."
            },
            {
              "id": "b",
              "text": "Substituir o código.",
              "correct": false,
              "explanation": "O código continua no diff."
            },
            {
              "id": "c",
              "text": "Listar a sua biografia.",
              "correct": false,
              "explanation": "Biografia não testa."
            }
          ]
        }
      ]
